# configuration for auth.js
AUTH_SECRET=// use `openssl rand -base64 32` to generate one
ORIGIN=http://localhost:8444

# configuration for motley-cue and ssh
# MC_ENDPOINT: URL used by the browser to reach motley-cue
MC_ENDPOINT=https://hpc.example.org/motley_cue:443
# INTERNAL_MC_ENDPOINT: URL used by server-side code to reach motley-cue
# (optional, defaults to MC_ENDPOINT)
# Useful in Docker where internal network differs from external access
# Example: INTERNAL_MC_ENDPOINT=http://motley-cue:8080
INTERNAL_MC_ENDPOINT=http://caddy:8080

SSH_HOSTNAME=localhost
SSH_CERT_HOSTNAME=localhost
SSH_PORT=1022

# SSH_METHOD will be mccli, unless it's set to oinit.
# If it is set to oinit, OINIT_ENDPOINT is required
SSH_METHOD=oinit
OINIT_ENDPOINT=http://localhost:8080/oinit/api/v1
