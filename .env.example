# configuration for auth.js
AUTH_SECRET=// use `openssl rand -base64 32` to generate one
ORIGIN=http://localhost:8444

# configuration for motley-cue and ssh
# PUBLIC_MC_ENDPOINT_URL: URL used by the browser to reach motley-cue
PUBLIC_MC_ENDPOINT_URL=https://hpc.example.org/motley_cue:443
# INTERNAL_MC_ENDPOINT_URL: URL used by server-side code to reach motley-cue
# (optional, defaults to PUBLIC_MC_ENDPOINT_URL)
# Useful in Docker where internal network differs from external access
# Example: INTERNAL_MC_ENDPOINT_URL=http://motley-cue:8080
INTERNAL_MC_ENDPOINT_URL=http://caddy:8080

PUBLIC_SSH_HOSTNAME_FQDN=localhost
PUBLIC_SSH_PORT=1022
